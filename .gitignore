# ==========================================
# 白名单模式：默认忽略全部，仅放行插件代码
# ==========================================
*

# 忽略规则本身
!.gitignore

# 插件清单与构建配置
!manifest.json
!package.json
!package-lock.json
!tsconfig.json
!esbuild.config.mjs

# 插件源码与类型声明
!src/
!src/**
!types/
!types/**

# 运行时资源与样式
!assets/
!assets/**
!styles.css

# 许可证
!LICENSE
